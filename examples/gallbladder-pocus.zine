    "1": {
      "html": "<div class=\"title f-mega\">GALL<br>BLADDER</div>\n<div class=\"sub f-pixel\">Point-of-care ultrasound</div>\n<div class=\"pat-bar pat-3\"></div>\n<p class=\"blurb\">A pocket guide for emergency medicine residents: find it, scan it, measure it, call it.</p>\n<p class=\"small\">Images are simulated illustrations.</p>",
      "css": "font-family: Helvetica, Arial, sans-serif;\nfont-size: 9.5px;\nline-height: 1.28;\nh2 {\n  font-family: 'Silkscreen', monospace;\n  font-size: 12px;\n  border-bottom: 2px solid #000;\n  margin-bottom: 4px;\n}\np {\n  margin: 0 0 4px;\n}\nul, ol {\n  margin: 0 0 4px 13px;\n}\nli {\n  margin-bottom: 2px;\n}\n.auto-image {\n  border: 1px solid #000;\n  margin-bottom: 3px;\n}\n.cap {\n  font-size: 8px;\n  font-style: italic;\n  margin-bottom: 5px;\n}\n.pat-box > div {\n  padding: 4px;\n}\n.auto-image {\n  margin-bottom: 10px;\n}\n.title {\n  font-size: 22px;\n  text-align: center;\n  line-height: 1.35;\n  margin-bottom: 6px;\n}\n.sub {\n  text-align: center;\n  font-size: 10px;\n}\n.blurb {\n  font-size: 11px;\n  text-align: center;\n  margin: 8px 4px;\n}\n.small {\n  text-align: center;\n  font-size: 7.5px;\n  font-style: italic;\n}",
      "image": "data:image/jpeg;base64,",
      "imageMode": "none",
      "dotSize": 1,
      "columns": 1,
      "useMaster": false,
      "flow": false,
      "bg": 0
