    "1": {
      "html": "<div class=\"cover-title f-mega\">GEO<br>ZINE</div>\n<div class=\"cover-sub f-pixel\">Issue 1 · The Desktop Publishing Issue</div>\n<div class=\"pat-bar pat-8\"></div>\n<p class=\"cover-blurb\">Everything this editor can do, demonstrated on the pages that do it.</p>\n<div class=\"cover-foot f-term\">8 pages · 1 sheet · 0 staples</div>",
      "css": ".auto-image {\n  border: 2px solid #000;\n  margin-bottom: 8px;\n}\n.cover-title {\n  font-size: 30px;\n  text-align: center;\n  letter-spacing: 2px;\n  margin: 4px 0 6px;\n}\n.cover-sub {\n  text-align: center;\n  font-size: 9px;\n  text-transform: uppercase;\n}\n.cover-blurb {\n  text-align: center;\n  font-style: italic;\n  margin: 6px 4px;\n}\n.cover-foot {\n  text-align: center;\n  font-size: 17px;\n}",
