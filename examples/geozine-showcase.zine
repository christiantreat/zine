    "3": {
      "html": "<h2 class=\"f-pixel\">Text Flow</h2>",
      "css": "h2 {\n  font-size: 12px;\n  padding-bottom: 4px;\n  margin-bottom: 6px;\n  border-bottom: 4px solid transparent;\n  border-image: repeating-linear-gradient(90deg, #000 0 2px, transparent 2px 4px) 4;\n}\n.zstory h3 {\n  border-bottom: 1px solid #000;\n}",
      "image": null,
